{
  "name": "agrysync-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && vite build --config vite.embed.config.ts",
    "build:android-web": "tsc -b && vite build --config vite.android.config.ts",
    "build:android": "npm run build:android-web && npx cap add android || true && npx cap sync android && npm run android:icons && cd android && gradlew.bat assembleRelease",
    "android:icons": "npx @capacitor/assets generate --android --assetPath resources",
    "android:setup": "npx cap add android || true && npx cap sync android && npm run android:icons",
    "android:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-android.ps1",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "cap:sync": "cap sync android",
    "cap:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^8.3.0",
    "@tanstack/react-query": "^5.56.0",
    "agrysync-admin": "file:..",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "i18next": "^23.15.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.26.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-background-sync": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.10.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
