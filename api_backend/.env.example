APP_NAME="AgriTrack API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Leave blank to use local SQLite (auto-created). Set for Postgres on Render.
DATABASE_URL=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

SANCTUM_TOKEN_EXPIRATION=10080

# OpenRouter — AI assistant (server-side only)
# Keys are rotated round-robin; a key that returns 401/402/429 is quarantined
# for OPENROUTER_QUARANTINE_SECONDS and the next fallback key is used.
# Three ways to declare fallbacks (they are merged, blanks/duplicates ignored):
#   1. OPENROUTER_API_KEY          → primary
#   2. OPENROUTER_API_KEY_2 … _10  → numbered fallbacks
#   3. OPENROUTER_API_KEYS         → comma-separated list (handy for many keys)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
# OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb,sk-or-v1-ccc

# Optional dedicated lanes. Leave blank to use the shared keys above.
# Planner: tool-calling/data lookup; Answer: final wording; Repair: self-check cleanup.
# Each lane supports the same _2…_10 numbered fallbacks and a plural list var,
# and automatically borrows a healthy shared key when its own lane is exhausted.
OPENROUTER_PLANNER_API_KEY=
OPENROUTER_PLANNER_API_KEY_2=
# OPENROUTER_PLANNER_API_KEYS=
OPENROUTER_ANSWER_API_KEY=
OPENROUTER_ANSWER_API_KEY_2=
# OPENROUTER_ANSWER_API_KEYS=
OPENROUTER_REPAIR_API_KEY=
OPENROUTER_REPAIR_API_KEY_2=
# OPENROUTER_REPAIR_API_KEYS=


# Models are hardcoded directly in config/openrouter.php (not env-driven) —
# edit the `models` / `planner_models` / `answer_models` / `repair_models`
# arrays there to change the roster.

# Identity headers (help OpenRouter classify legitimate traffic).
OPENROUTER_REFERER=
OPENROUTER_TITLE="Flehty Assistant"

# Timeouts (seconds)
OPENROUTER_CONNECT_TIMEOUT=15
OPENROUTER_REQUEST_TIMEOUT=60
OPENROUTER_STREAM_IDLE_TIMEOUT=90

# Retry / backoff
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BASE_MS=400
OPENROUTER_RETRY_MAX_MS=4000
OPENROUTER_QUARANTINE_SECONDS=300
# Full passes over the whole model fallback chain — each extra pass
# multiplies worst-case latency, keep at 1 unless outages are frequent.
OPENROUTER_RECOVERY_PASSES=1

# Tool-calling agent loop rounds. A real question rarely needs more than a
# handful; higher only helps a looping free model, at the cost of latency.
OPENROUTER_AGENT_MAX_ITERATIONS=8

# Self-check repair rounds — each is a full extra model round-trip.
AI_REPAIR_PASSES=2

# Prompt cache
OPENROUTER_CACHE_ENABLED=true
OPENROUTER_CACHE_TTL=600

# Circuit breaker
OPENROUTER_BREAKER_WINDOW=60
OPENROUTER_BREAKER_MIN_SAMPLES=6
OPENROUTER_BREAKER_THRESHOLD=0.5
OPENROUTER_BREAKER_COOLDOWN=30

# Per-user daily token budget
OPENROUTER_BUDGET_ENABLED=true
OPENROUTER_DAILY_TOKENS=200000
